// The "Snart här" page on the naked platform domain while production does not
// exist (Mikael 2026-10-27). An assets-only Worker: no code, one HTML file and
// the logo, bound to the apex by a ROUTE (not a custom domain) so the zone's
// placeholder record stays as it is.
//
// ⚠️ CUTOVER (CP7): a route takes precedence over a custom domain on the same
// hostname (Cloudflare docs, Routes). This route MUST be deleted before or in
// the same step as the production web Worker takes `flippinstuff.se`:
//   wrangler delete --config cloudflare/coming-soon/wrangler.jsonc
// (removes the Worker and its route). Recorded in the handover 2026-10-27.
//
// Deploy (project token injected per command, never the shell's):
//   env CLOUDFLARE_API_TOKEN=… npx wrangler deploy --config cloudflare/coming-soon/wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flippinstuff-coming-soon",
  "compatibility_date": "2026-08-15",
  "account_id": "ee213082783ec86585150e876edb6107",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "flippinstuff.se/*", "zone_id": "8398c81a4350f45e807f7ef4610baa1a" }
  ]
}
