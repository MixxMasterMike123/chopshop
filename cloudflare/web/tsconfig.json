{
  // chopshop-web's own sources, checked with the API's compiler settings:
  // `cd cloudflare && npx tsc --noEmit -p web`. The web Worker imports nothing
  // outside web/src; the runtime types come from @cloudflare/workers-types, not
  // from the API's generated file (that one pulls in the API's own modules).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"]
}
