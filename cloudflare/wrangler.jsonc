{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meteorshop-stg-api",
  "account_id": "0d392e5c79e386966a98a214ac91a133",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "APP_ENV": "staging",
    "AUTH_BASE_URL": "https://meteorshop-stg-api.micke-ohlen.workers.dev",
    "AUTH_TRUSTED_ORIGINS": "https://meteorshop-stg-api.micke-ohlen.workers.dev",
    // The R2 S3 endpoint's account id. A VAR, not a secret, and deliberately:
    // it appears in plaintext inside every presigned URL the POD surface mints,
    // and it is already recorded as a non-secret configuration identifier
    // elsewhere in this repo (it is the `account_id` above). It must live here
    // because CLOUDFLARE EXPOSES NO ACCOUNT ID TO A WORKER AT RUNTIME — there is
    // no binding and no global, and the top-level `account_id` is a deploy-time
    // targeting field that is never injected into `env`.
    "R2_ACCOUNT_ID": "0d392e5c79e386966a98a214ac91a133",
    // The private bucket's NAME, as distinct from the PRIVATE_BUCKET binding
    // below. Both are needed and they are not interchangeable: the binding moves
    // bytes without credentials, while a presigned S3 URL must address the
    // bucket by name — and a binding carries no way to recover the name it
    // points at.
    "R2_PRIVATE_BUCKET_NAME": "meteorshop-stg-private",
    "SERVICE_NAME": "meteorshop-stg-api"
  },
  "r2_buckets": [
    {
      "binding": "PRIVATE_BUCKET",
      "bucket_name": "meteorshop-stg-private"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meteorshop-stg-db",
      "database_id": "d709e702-17f6-4107-ad45-060f2b24dc89",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AUTH_EMAIL_QUEUE",
        "queue": "meteorshop-stg-email-auth"
      }
    ],
    "consumers": [
      {
        "queue": "meteorshop-stg-email-auth",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 8,
        "dead_letter_queue": "meteorshop-stg-email-auth-dlq",
        "max_concurrency": 2
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
