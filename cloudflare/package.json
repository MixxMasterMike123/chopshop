{
  "name": "meteorshop-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check": "npm run types:check && npm run build && npm test",
    "dev": "wrangler dev --local --env staging",
    "startup": "wrangler check startup",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types worker-configuration.d.ts --env staging",
    "types:check": "wrangler types worker-configuration.d.ts --env staging --check"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260815.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "aws4fetch": "1.0.20",
    "better-auth": "1.6.29",
    "hono": "4.13.9",
    "stripe": "22.5.0"
  }
}
